# Copy to .env (compose auto-loads it) or export DB_PASSWORD in your shell.
# No default password exists anywhere by design — compose and Spring both fail fast when unset.
DB_PASSWORD=change-me-locally
# Optional overrides (defaults: financialgps / financialgps / localhost / 5434):
# DB_NAME=financialgps
# DB_USER=financialgps
# DB_HOST=localhost
# DB_PORT=5434
