{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true,
    },
    "mermaid": {
      "type": "local",
      "command": ["npx", "-y", "mcp-mermaid"],
      "enabled": true,
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest"],
      "enabled": true,
    },
  },
  "references": {
    "frontend": {
      "path": "./frontend",
      "description": "Vue frontend of financial-gps — pages, stores, API client",
    },
    "backend": {
      "path": "./backend",
      "description": "Spring Boot backend of financial-gps — API, use cases, domain",
    },
    "e2e": {
      "path": "./e2e",
      "description": "Playwright end-to-end tests for financial-gps",
    },
  },
}
