{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 30000
    },
    "servers": {
      "codegraph": {
        "type": "local",
        "command": ["codegraph", "serve", "--mcp"]
      },
      "mermaid": {
        "type": "local",
        "command": ["mcp-mermaid"],
        "timeout": {
          "startup": 60000
        }
      },
      "chrome-devtools": {
        "type": "local",
        "command": ["npx", "-y", "chrome-devtools-mcp@1.10.1"],
        "timeout": {
          "startup": 120000,
          "catalog": 60000
        }
      }
    }
  },
  "references": {
    "frontend": {
      "path": "./frontend",
      "description": "Vue frontend of financial-gps — pages, stores, API client",
    },
    "backend": {
      "path": "./backend",
      "description": "Spring Boot backend of financial-gps — API, use cases, domain",
    },
    "e2e": {
      "path": "./e2e",
      "description": "Playwright end-to-end tests for financial-gps",
    },
  },
}
